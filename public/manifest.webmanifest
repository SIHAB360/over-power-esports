{
  "name": "OVER POWER ESPORTS",
  "short_name": "OVER POWER",
  "description": "OVER POWER ESPORTS secure app with native-style login, player and admin tabs, matches, wallet and alerts.",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0c1731",
  "theme_color": "#5368db",
  "lang": "en",
  "icons": [
    {
      "src": "/pwa-icon/192",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/pwa-icon/512",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open App Home",
      "short_name": "App Home",
      "url": "/app",
      "description": "Open your OVER POWER ESPORTS software"
    },
    {
      "name": "Match Center",
      "short_name": "Matches",
      "url": "/app",
      "description": "Sign in to your own match dashboard"
    }
  ]
}
